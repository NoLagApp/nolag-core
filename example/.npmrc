# @nolag/core is a `file:..` dependency during development.
#
# Without this, npm symlinks it, and Node then resolves the library's imports
# through the library's OWN node_modules. Since the library keeps its peers
# (@nestjs/typeorm, typeorm, class-validator) as devDependencies so its tests
# can run, that means two copies of TypeORM in one process: the DataSource the
# library asks Nest for is a different class from the one the host registered,
# and dependency injection fails with an unresolvable DataSource.
#
# install-links packs and extracts the dependency instead, exactly as npm would
# from the registry. `files` applies, devDependencies stay behind, and peers
# resolve from here. It also means the example is genuinely testing the
# published artefact rather than a source directory.
#
# Consequence: run `npm run build` in the parent, then `npm install` here, after
# any library change. There is no live link.
install-links=true
