# nolag-core configuration
#
# Only the Postgres settings are required. Everything else has a working
# default, because a self-hosted deployment should not need to understand
# NoLag's internals to start the service.

NODE_ENV=development
PORT=3000

# ── Postgres (required) ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nolag
POSTGRES_PASSWORD=nolag
POSTGRES_DATABASE=nolag_core

# Unix socket directory. When set, takes precedence over host and port.
# POSTGRES_SOCKET_PATH=/cloudsql/project:region:instance

POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10

# ── Migrations ─────────────────────────────────────────────────────────────
# Set to "true" to start without applying migrations. Only needed when
# something other than core owns the schema.
SKIP_MIGRATIONS=false

# ── Client tokens (optional) ───────────────────────────────────────────────
# 32 bytes, base64 encoded. Required only if you issue browser client tokens.
# Generate with: openssl rand -base64 32
# Without it, signing key operations are refused. Opaque actor tokens are
# unaffected.
SIGNING_KEY_ENCRYPTION_KEY=

# ── Default limits (optional) ──────────────────────────────────────────────
# Applied when a project has no limits configured. Leave empty for unlimited,
# which is the sensible default when nobody is billing for capacity.
DEFAULT_MAX_CONNECTIONS=
DEFAULT_MAX_MESSAGE_SIZE_BYTES=
DEFAULT_SESSION_EXPIRY_SECONDS=3600
