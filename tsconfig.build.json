{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    // The published artefact must not carry paths from this machine.
    "sourceMap": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "example",
    "tools",
    "ui",
    "test",
    "**/*.spec.ts"
  ]
}
